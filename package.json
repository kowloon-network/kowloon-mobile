{
  "name": "kowloon-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "distribute:android": "node scripts/distribute-android.mjs",
    "postinstall": "patch-package",
    "eas-build-pre-install": "(test -d ../client || git clone --depth 1 https://github.com/kowloon-network/kowloon-client.git ../client) && (test -d ../design || git clone --depth 1 https://github.com/kowloon-network/kowloon-design.git ../design)",
    "eas-build-on-success": "node scripts/eas-distribute-onsuccess.mjs"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@expo/cli": "^55.0.33",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ngrok": "^4.1.3",
    "@kowloon/client": "file:../client",
    "@kowloon/design": "file:../design",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@reduxjs/toolkit": "^2.12.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "expo-video-thumbnails": "~57.0.2",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
